<Page x:Class="barcodrod.io.Views.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:barcodrod.io.ViewModels"
      xmlns:local="using:barcodrod.io.Views"
      Loaded="PageLoaded" SizeChanged="PageSizeChanged">
    <Grid Margin="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Inventory_Title" Text="Inventory" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" AutomationProperties.AutomationId="InventorySummary" TextWrapping="Wrap"/>
            </StackPanel>
            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24"/>
        </Grid>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="True"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" IsEnabled="{x:Bind ViewModel.CanWork, Mode=OneWay}">
            <CommandBar.Content><TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="InventorySelection"/></CommandBar.Content>
            <AppBarButton Label="New item" Icon="Add" Click="NewItem" AutomationProperties.AutomationId="InventoryNew"/>
            <AppBarButton Label="Edit" Icon="Edit" Click="EditItem" IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}" AutomationProperties.AutomationId="InventoryEdit"/>
            <AppBarButton Label="Update quantity" Icon="Switch" Click="RecordStock" IsEnabled="{x:Bind ViewModel.CanChangeQuantity, Mode=OneWay}" AutomationProperties.AutomationId="InventoryStock"/>
            <AppBarButton Label="Print labels" Icon="Print" Click="PrintLabels" IsEnabled="{x:Bind ViewModel.CanLabelSelection, Mode=OneWay}" AutomationProperties.AutomationId="InventoryPrint"/>
            <AppBarButton Label="Excel" Click="ConnectExcel" AutomationProperties.AutomationId="InventoryConnect">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;"/></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Import Excel / CSV" Icon="Import" Click="ImportFile" AutomationProperties.AutomationId="InventoryImport"/>
                <AppBarButton Label="Export Excel / CSV" Icon="Save" Click="ExportFile" AutomationProperties.AutomationId="InventoryExport"/>
                <AppBarButton Label="Column mapping" Icon="Setting" Click="ConfigureColumns" AutomationProperties.AutomationId="InventoryColumns"/>
                <AppBarButton Label="Export activity log" Icon="List" Click="ExportMovements" AutomationProperties.AutomationId="InventoryExportLog"/>
                <AppBarButton Label="Archive / restore selected" Icon="Delete" Click="ArchiveItems" AutomationProperties.AutomationId="InventoryArchive"/>
                <AppBarButton Label="Back up inventory" Icon="SaveLocal" Click="BackupInventory" AutomationProperties.AutomationId="InventoryBackup"/>
                <AppBarButton Label="Restore inventory backup" Icon="Upload" Click="RestoreInventory" AutomationProperties.AutomationId="InventoryRestore"/>
                <AppBarButton Label="Select all shown" Icon="SelectAll" Click="SelectAll" AutomationProperties.AutomationId="InventorySelectAll"/>
                <AppBarButton Label="Clear selection" Icon="Cancel" Click="ClearSelection" AutomationProperties.AutomationId="InventoryClearSelection"/>
                <AppBarButton Label="Item details" Icon="More" Click="ShowDetails" IsEnabled="{x:Bind ViewModel.CanEditSelection, Mode=OneWay}" AutomationProperties.AutomationId="InventoryDetails"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SearchColumn" Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SortColumn" Width="*"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="SearchPanel" Spacing="4">
            <TextBlock Text="Search or scan" Style="{StaticResource CaptionTextBlockStyle}"/>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Name, item ID, barcode, location…" QueryIcon="Find"
                            Text="{x:Bind ViewModel.Query, Mode=TwoWay}" QuerySubmitted="ScanSubmitted" IsEnabled="{x:Bind ViewModel.CanWork, Mode=OneWay}"
                            AutomationProperties.Name="Search or scan inventory" AutomationProperties.AutomationId="InventorySearch"/>
            </StackPanel>
            <ComboBox x:Name="FilterBox" Grid.Column="1" Header="Show" ItemsSource="{x:Bind ViewModel.Filters}" SelectedItem="{x:Bind ViewModel.Filter, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Filter inventory" AutomationProperties.AutomationId="InventoryFilter"/>
            <ComboBox x:Name="SortBox" Grid.Column="2" Header="Sort by" ItemsSource="{x:Bind ViewModel.Sorts}" SelectedItem="{x:Bind ViewModel.Sort, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Sort inventory" AutomationProperties.AutomationId="InventorySort"/>
        </Grid>
        <ScrollViewer x:Name="ToolsScroller" Grid.Row="3" MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Expander x:Name="ScanTools" Header="Scan shortcuts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                  AutomationProperties.AutomationId="InventoryTools" IsEnabled="{x:Bind ViewModel.CanWork, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="Scan, paste a barcode, or type an item ID in the search box, then press Enter. Look up finds an item; Add or Remove changes its quantity on every scan." TextWrapping="Wrap"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                    <ComboBox Header="On scan" ItemsSource="{x:Bind ViewModel.ScanActions}" SelectedItem="{x:Bind ViewModel.ScanAction, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InventoryScanAction"/>
                    <NumberBox Grid.Column="1" Header="Quantity" Value="{x:Bind ViewModel.ScanQuantity, Mode=TwoWay}" Minimum="0.001" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="InventoryScanQuantity"/>
                </Grid>
                <TextBox Header="Reference (optional)" Text="{x:Bind ViewModel.ScanReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="InventoryScanReference"/>
            </StackPanel>
        </Expander>
        <Expander x:Name="ExcelTools" Grid.Column="1" Header="Excel workbook" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.AutomationId="InventoryExcelTools" IsEnabled="{x:Bind ViewModel.CanWork, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.ExcelStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="InventoryExcelStatus"/>
                <TextBlock Text="Connect using Excel in the toolbar. Save writes app changes; Sync also brings in workbook edits. Your local inventory works without a workbook." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                <StackPanel Spacing="8">
                    <Button Content="Sync both ways" Command="{x:Bind ViewModel.SyncCommand}" AutomationProperties.AutomationId="InventorySync"/>
                    <Button Content="Save to Excel" Command="{x:Bind ViewModel.SaveExcelCommand}" AutomationProperties.AutomationId="InventorySaveExcel"/>
                    <Button Content="Open record in Excel" Command="{x:Bind ViewModel.OpenExcelCommand}" AutomationProperties.AutomationId="InventoryOpenExcel"/>
                </StackPanel>
            </StackPanel>
        </Expander>
        </Grid>
        </ScrollViewer>
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="320"/></Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Padding="40,8,12,8" ColumnSpacing="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Item" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Quantity"/><TextBlock Grid.Column="2" Text="Status"/>
                </Grid>
                <ListView x:Name="InventoryList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Multiple"
                          SelectionChanged="ItemSelected" DoubleTapped="ItemDoubleTapped" ContainerContentChanging="RecordContainerChanging"
                          IsEnabled="{x:Bind ViewModel.CanWork, Mode=OneWay}" AutomationProperties.AutomationId="InventoryList" AutomationProperties.Name="Inventory records">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:InventoryRow">
                            <Grid Padding="0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Context, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Context}" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{x:Bind Quantity, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Availability, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind State, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No items match this view. Add an item or import an Excel / CSV file from the toolbar menu." TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ScrollViewer x:Name="DetailPane" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="InventoryDetailText"/>
                <TextBlock Text="Recent activity" FontWeight="SemiBold"/>
                <!-- The activity feed is capped at 25 records. One scroll surface keeps details reachable at short heights. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentMovements}" AutomationProperties.AutomationId="InventoryMovements" AutomationProperties.Name="Recent inventory activity">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MovementRow"><StackPanel Spacing="4" Padding="0,4"><TextBlock Text="{x:Bind Summary, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <ScrollViewer Grid.Row="5" MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <InfoBar x:Name="InventoryStatus" Message="{x:Bind ViewModel.Status, Mode=OneWay}" IsOpen="True" IsClosable="False" AutomationProperties.AutomationId="InventoryStatus" AutomationProperties.Name="{x:Bind ViewModel.Status, Mode=OneWay}">
            <InfoBar.ActionButton><Button Content="Restore backup" Click="RestoreInventory" IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}" Visibility="{x:Bind local:InventoryPage.Visible(ViewModel.NeedsRecovery), Mode=OneWay}" AutomationProperties.AutomationId="InventoryRecover"/></InfoBar.ActionButton>
        </InfoBar>
        </ScrollViewer>
    </Grid>
</Page>
